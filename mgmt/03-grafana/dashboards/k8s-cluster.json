    },
    {
      "type": "stat",
      "id": 6,
      "title": "재시작 (구간)",
      "description": "선택 구간 동안 컨테이너가 재시작한 총 횟수. 1회 이상 주황, 10회 이상 빨강. 새로 생긴 파드는 첫 수집(최대 1분) 전 재시작이 빠진다.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max_over_time(k8s_container_restarts{cluster=\"$cluster\", namespace=~\"$namespace\"}[$__range]) - min_over_time(k8s_container_restarts{cluster=\"$cluster\", namespace=~\"$namespace\"}[$__range])) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "interval": "1m",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "value": 1,
                "color": "orange"
              },
              {
                "value": 10,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "type": "stat",
      "id": 7,
      "title": "가용 부족 워크로드",
      "description": "desired보다 ready/available이 적은 Deployment·StatefulSet·DaemonSet 수 (otel-collector 자신 포함).",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 15,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(count((k8s_deployment_desired{cluster=\"$cluster\", namespace=~\"$namespace\"} - k8s_deployment_available{cluster=\"$cluster\", namespace=~\"$namespace\"}) > 0) or vector(0)) + (count((k8s_statefulset_desired_pods{cluster=\"$cluster\", namespace=~\"$namespace\"} - k8s_statefulset_ready_pods{cluster=\"$cluster\", namespace=~\"$namespace\"}) > 0) or vector(0)) + (count((k8s_daemonset_desired_scheduled_nodes{cluster=\"$cluster\", namespace=~\"$namespace\"} - k8s_daemonset_ready_nodes{cluster=\"$cluster\", namespace=~\"$namespace\"}) > 0) or vector(0))",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "interval": "1m",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "type": "stat",
      "id": 8,
      "title": "경고 이벤트 (구간)",
      "description": "선택 구간의 Warning 이벤트 수 (BackOff, Unhealthy, FailedScheduling, FailedMount ...). 아래 이벤트 목록에서 내용 확인.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({cluster=\"$cluster\", app=\"k8s-events\", namespace=~\"$namespace\"} | severity_text=\"Warning\" [$__range]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "value": 1,
                "color": "orange"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "type": "stat",
      "id": 9,
      "title": "마지막 수신",
      "description": "클러스터 상태 메트릭이 마지막으로 들어온 뒤 지난 시간. 3분 넘으면 주황, 10분 넘으면 빨강 — otel-cluster 파드나 mgmt 전송 경로 장애. \"수신 없음\"(빨강)이면 최근 5분 안에 이 클러스터 데이터가 하나도 없다 — 이때 다른 칸의 0은 정상이라는 뜻이 아니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(timestamp(k8s_node_condition_ready{cluster=\"$cluster\"})) or vector(-1)",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "interval": "1m",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "수신 없음",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "수신 없음",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "value": 180,
                "color": "orange"
              },
              {
                "value": 600,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "type": "row",
      "id": 10,
      "title": "노드",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "table",
      "id": 11,
      "title": "노드별 request 할당률 (근사)",
      "description": "노드에 배치된 파드의 CPU·메모리 request 합 / allocatable. 100%에 가까우면 새 파드(DaemonSet 포함)가 그 노드에 못 들어가 Pending이 된다 — 실제 사용률이 낮아도 그렇다. initContainers로 선언된 native sidecar(Istio 1.2x 등)의 request는 k8s_cluster가 보고하지 않아 빠지므로 실제는 이보다 조금 높다 (dev 실측 93% vs kubectl describe 99%). 정확한 값: kubectl describe node.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (k8s_container_cpu_request{cluster=\"$cluster\", node!=\"\"} and on (namespace, pod) (k8s_pod_phase{cluster=\"$cluster\"} <= 2)) / sum by (node) (k8s_node_allocatable_cpu{cluster=\"$cluster\"}) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "interval": "1m",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (node) (k8s_container_memory_request_bytes{cluster=\"$cluster\", node!=\"\"} and on (namespace, pod) (k8s_pod_phase{cluster=\"$cluster\"} <= 2)) / sum by (node) (k8s_node_allocatable_memory_bytes{cluster=\"$cluster\"}) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "interval": "1m",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "node": "노드",
              "Value #A": "CPU",
              "Value #B": "메모리"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "value": 85,
                "color": "orange"
              },
              {
                "value": 95,
                "color": "red"
              }
            ]
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(CPU|메모리)$"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "노드 CPU 사용률",
      "description": "kubelet이 잰 노드 CPU 사용량 / allocatable.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 5,
        "x": 9,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (k8s_node_cpu_usage{cluster=\"$cluster\"}) / sum by (node) (k8s_node_allocatable_cpu{cluster=\"$cluster\"}) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "interval": "1m",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0,
            "spanNulls": false,
            "gradientMode": "none",
            "axisSoftMax": 100,
            "thresholdsStyle": {
              "mode": "dashed"
