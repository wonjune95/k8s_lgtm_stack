    {
      "type": "stat",
      "id": 5,
      "title": "문제 컨테이너",
      "description": "CrashLoopBackOff·ImagePullBackOff·ErrImagePull·OOMKilled·Error·CreateContainerConfigError 상태 컨테이너 수.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 9,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(k8s_container_status_reason{cluster=\"$cluster\", namespace=~\"$namespace\", k8s_container_status_reason!~\"Completed|ContainerCreating\"} == 1) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "interval": "1m",
          "instant": true,
          "range": false
