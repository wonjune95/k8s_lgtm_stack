{
  "uid": "k8s-cluster",
  "title": "쿠버네티스 클러스터 상태",
  "tags": [
    "kubernetes",
    "lgtm"
  ],
  "description": "노드·파드·컨테이너 상태와 이벤트 — otel kubeletstats·k8s_cluster·k8s_objects 수집. 알림 대신 맨 윗줄을 볼 것.",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "links": [
    {
      "title": "서비스 메시 개요",
      "type": "link",
      "url": "/d/mesh-service-graph",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "tooltip": "",
      "asDropdown": false,
      "tags": []
    }
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "클러스터",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "definition": "label_values(k8s_node_condition_ready, cluster)",
        "query": {
          "query": "label_values(k8s_node_condition_ready, cluster)",
          "refId": "cluster"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "네임스페이스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "definition": "label_values(k8s_pod_phase{cluster=\"$cluster\"}, namespace)",
        "query": {
          "query": "label_values(k8s_pod_phase{cluster=\"$cluster\"}, namespace)",
          "refId": "namespace"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "지금 상태 — 0이 아니면 아래에서 원인 확인 (선택 구간 기준: 재시작·경고 이벤트)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "NotReady 노드",
      "description": "Ready condition이 False(0) 또는 Unknown(-1)인 노드 수. 노드가 끊기면 Unknown이 된다.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(k8s_node_condition_ready{cluster=\"$cluster\"} != 1) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "interval": "1m",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "노드 압박",
      "description": "MemoryPressure·DiskPressure·PIDPressure 중 하나라도 켜진 노드 수. 켜지면 kubelet이 파드를 축출한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (node) ({cluster=\"$cluster\", __name__=~\"k8s_node_condition_(memory|disk|pid)_pressure\"}) == 1) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "interval": "1m",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "비정상 파드",
      "description": "Pending·Failed·Unknown 파드 수 (스케줄 실패, 이미지 못 받음, 볼륨 마운트 실패 등).",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(k8s_pod_phase{cluster=\"$cluster\", namespace=~\"$namespace\"} == 1 or k8s_pod_phase{cluster=\"$cluster\", namespace=~\"$namespace\"} >= 4) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "interval": "1m",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
