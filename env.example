# cp env.example env 로 복사한 뒤 값을 채운다. env 는 커밋하지 않는다(.gitignore).

# mgmt 클러스터 Traefik Gateway가 HTTPS로 받는 도메인 4개. 내부 DNS에 등록돼 있어야 하고,
# Gateway의 인증서 SAN에 4개가 모두 들어 있어야 한다(와일드카드 가능).
LOKI_DOMAIN=loki.example.com
MIMIR_DOMAIN=mimir.example.com
TEMPO_DOMAIN=tempo.example.com
GRAFANA_DOMAIN=grafana.example.com

# mgmt의 PVC가 쓸 StorageClass(RWO). Loki·Mimir·Tempo 각 100Gi, Grafana 30Gi (크기는 처음 만들 때만 적용된다)
STORAGE_CLASS=standard

# mgmt의 Traefik Gateway 이름과 네임스페이스 (kubectl get gateway -A). allowedRoutes가 monitoring 네임스페이스를 허용해야 한다
GATEWAY_NAME=traefik-gateway
GATEWAY_NAMESPACE=traefik

# 위 4개 도메인의 서버 인증서를 발급한 CA 인증서(PEM). dev/stg/prod의 otel이 이 CA로 mgmt 인증서를 검증한다.
# 공인 CA 발급이면 그 루트(또는 체인) PEM을 넣는다. 여러 CA를 믿게 하려면 PEM을 이어 붙인 파일을 준다.
MGMT_CA_PEM=/path/to/ca.pem

# (선택) 사설 미러 레지스트리. 비우면 docker.io 공개 이미지를 digest 고정으로 쓴다.
# 미러에 복사할 때 digest를 보존해야 한다(예: skopeo copy --preserve-digests). pull 인증이 필요하면 imagePullSecrets는 직접 추가.
REGISTRY=
